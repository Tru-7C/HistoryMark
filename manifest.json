{
    "name": "TabMark",
    "version": "0.0.0.1",
    "manifest_version": 3,
    "description": "Mark the page, Check later!",
    "icons": {
        "16": "icons/bookmark_16px.png",
        "32": "icons/bookmark_32px.png",
        "48": "icons/bookmark_64px.png",
        "128": "icons/bookmark_128px.png"
    },
    "content_scripts": [
    {
        "matches": ["<all_urls>"],
        "js": ["lib/jquery.min.js", "lib/svg.min.js", "content-scripts/content.js"]
    }
    ],
    "action": {
        "default_popup": "popup/popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": ["<all_urls>"],
    "permissions": [
        "history",
        "scripting",
        "tabs",
        "activeTab",
        "storage",
        "contextMenus"
    ],
    "web_accessible_resources": [
        {
            "resources": ["icons/bookmarkIcon.svg"],
            "matches": ["<all_urls>"]
        }
    ]
}